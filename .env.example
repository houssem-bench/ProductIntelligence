APP_NAME=ProductIntelligence_V2
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
CACHE_TTL_SECONDS=900
MAX_PARALLEL_ANALYSES=4

OFF_USER_AGENT=ProductIntelligenceV2/1.0 (contact@example.com)
SERPAPI_KEY=
# Must be public (ngrok/cloudflared URL), not localhost.
PUBLIC_BASE_URL=
# Backward-compatible alias for PUBLIC_BASE_URL.
NGROK_BASE_URL="https://subattenuate-joanne-vacuous.ngrok-free.dev"
# Optional: automatically create a public URL if PUBLIC_BASE_URL is empty.
ENABLE_NGROK=false
# Optional: recommended for stable ngrok usage/rate limits.
NGROK_AUTHTOKEN="3ABr7PpzSfpJWAEYTvJ1ZgkVrqo_2dSbD2bSeF6N9UWgbQ5oD"
# Optional reserved domain (paid ngrok plan).
NGROK_DOMAIN=
LENS_MAX_MATCHES=5
LENS_COUNTRY=TN
LENS_SAFE=off

# Optional: Grok enrichment for products_list JSON structuring.
GROK_API_KEY=
GROK_MODEL=grok-3-latest
GROK_BASE_URL=https://api.x.ai/v1

ENABLE_YOLO=true
YOLO_MODEL_PATH=..\yolov8l-seg.pt
YOLO_CONF_THRESHOLD=0.2

# Optional: absolute path to tesseract.exe on Windows.
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

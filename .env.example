APP_NAME=ProductIntelligence_V2
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
CACHE_TTL_SECONDS=900
MAX_PARALLEL_ANALYSES=4

OFF_USER_AGENT=ProductIntelligenceV2/1.0 (contact@example.com)
SERPAPI_KEY=
# Must be public (ngrok/cloudflared URL), not localhost.
PUBLIC_BASE_URL=

ENABLE_YOLO=true
YOLO_MODEL_PATH=..\yolov8l-seg.pt
YOLO_CONF_THRESHOLD=0.2

# Optional: absolute path to tesseract.exe on Windows.
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
